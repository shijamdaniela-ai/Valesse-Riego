<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#F4F6F4">

    <!-- Título principal -->
    <TextView
        android:id="@+id/tvTituloMonitoreo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema Riego"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_marginBottom="12dp" />

    <!-- Selector de plantas -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona la planta:"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spPlantasMonitoreo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="16dp" />

    <!-- TARJETA CIRCULAR: Aquí cambiará el porcentaje al regar -->
    <androidx.cardview.widget.CardView
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:cardCornerRadius="90dp"
        app:cardElevation="6dp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUMEDAD"
                android:textSize="11sp"
                android:textColor="#757575"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Porcentaje que irá subiendo -->
            <TextView
                android:id="@+id/tvEstadoHumedad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42%"
                android:textSize="36sp"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- UMBRAL MÁXIMO ABAJO DEL CÍRCULO -->
    <TextView
        android:id="@+id/tvInfoProgramacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ Umbral máximo de humedad: 80%"
        android:textSize="14sp"
        android:textColor="#2E7D32"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Espaciador flexible para empujar botones hacia abajo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTONES INFERIORES -->
    <Button
        android:id="@+id/btnActivarRiego"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="INICIAR RIEGO AUTOMÁTICO"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="10dp"
        app:cornerRadius="8dp" />

    <Button
        android:id="@+id/btnConfigurar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="⚙️ Configurar Planta"
        android:onClick="irAConfiguracion"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"
        app:cornerRadius="8dp" />

    <Button
        android:id="@+id/btnVerHistorial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="📋 Ver Historial de Riego"
        android:onClick="irAHistorial"
        android:backgroundTint="#388E3C"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp" />

</LinearLayout>