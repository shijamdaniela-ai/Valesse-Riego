<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F4"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".Esp32ConexionActivity">

    <!-- Título superior -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Conexión Hardware IoT"
        android:textColor="#1B5E20"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Módulo ESP32 - Sistema Valessè"
        android:textColor="#558B2F"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Tarjeta de Estado del Dispositivo -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#2E7D32"
                android:layout_marginBottom="12dp"
                android:contentDescription="Icono ESP32"/>

            <TextView
                android:id="@+id/tvEstadoConexion"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginBottom="8dp"
                android:text="Estado: Buscando"
                android:textColor="#FF9800"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleDispositivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Dispositivo cercano detectado"
                android:textColor="#757575"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botón para Buscar / Conectar ESP32 -->
    <Button
        android:id="@+id/btnEscanear"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2E7D32"
        android:text="Conectar con ESP32"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

    <!-- Botón de Conectar / Sincronizar (inicialmente oculto o desactivado) -->
    <Button
        android:id="@+id/btnConectarEsp32"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#7CFFEB3B"
        android:enabled="false"
        android:text="Verificar y continuar"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

    <!-- Progreso de carga simulado -->
    <ProgressBar
        android:id="@+id/progressBarEsp32"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="24dp"/>

    <!-- Nota Informativa Offline/IoT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Nota: Esta interfaz simula el puente de comunicación local vía Bluetooth/Wi-Fi Direct entre el dispositivo Android y el microcontrolador ESP32."
        android:textColor="#616161"
        android:textSize="12sp"
        android:gravity="center"/>

</LinearLayout>