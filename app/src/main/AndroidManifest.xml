<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Valessé">

        <!-- 1. LOGIN (Punto de entrada de la app) -->
        <activity
            android:name=".Login"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. MAIN -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. INICIO -->
        <activity
            android:name=".activity_inicio"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. ESP32 CONEXIÓN -->
        <activity
            android:name=".Esp32_conexion"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. PLANTAS -->
        <activity
            android:name=".activity_plantas"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. MONITOREO -->
        <activity
            android:name=".activity_monitoreo"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Historial y Configuración (Posteriores a Monitoreo) -->
        <activity
            android:name=".activity_historial"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity_configuracion"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>